#!/bin/sh
# Не даёт закоммитить русскую страницу без пересборки узбекской.
#
# Ставится один раз командой:
#     git config core.hooksPath .githooks
#
# Если правился index.html или build-uz.py — пересобирает uz/index.html
# и добавляет результат в тот же коммит. Если сборка падает (изменилась
# русская строка без пары или появился непереведённый текст) — коммит
# отменяется с объяснением.

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

# срабатываем только если затронуты исходники узбекской версии
if ! git diff --cached --name-only | grep -qE '^(index\.html|build-uz\.py)$'; then
    exit 0
fi

echo "pre-commit: пересобираю узбекскую версию…"
if ! python3 build-uz.py; then
    cat <<'MSG'

Коммит отменён: узбекская версия не собирается.

Что делать: открыть build-uz.py и поправить пару перевода для строки,
которую показал сборщик выше. Затем повторить коммит.
MSG
    exit 1
fi

git add uz/index.html
exit 0
